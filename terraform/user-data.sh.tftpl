#!/bin/bash
# Körs automatiskt vid första uppstart av EC2 (cloud-init).
set -eux

# 1. Paket: nginx (webbserver från Level 3) + Python
dnf -y install nginx python3 python3-pip

# 2. Applikationskoden
mkdir -p /opt/app
echo "${app_py_b64}" | base64 -d > /opt/app/app.py
echo "${requirements_b64}" | base64 -d > /opt/app/requirements.txt
python3 -m venv /opt/app/venv
/opt/app/venv/bin/pip install -r /opt/app/requirements.txt

# 3. API-nyckeln: bara på servern, läsbar endast av root
cat > /etc/app.env <<'EOF'
GEMINI_API_KEY=${gemini_api_key}
EOF
chmod 600 /etc/app.env

# 4. Appen som systemd-tjänst (gunicorn på localhost:5000)
cat > /etc/systemd/system/app.service <<'EOF'
[Unit]
Description=IT-ordboken GenAI app
After=network.target

[Service]
EnvironmentFile=/etc/app.env
WorkingDirectory=/opt/app
ExecStart=/opt/app/venv/bin/gunicorn -w 2 --timeout 120 -b 127.0.0.1:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
EOF

# 5. nginx som reverse proxy: port 80 -> 127.0.0.1:5000
cat > /etc/nginx/conf.d/app.conf <<'EOF'
server {
    listen 80 default_server;
    server_name _;
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
}
EOF
systemctl daemon-reload
systemctl enable --now app
systemctl enable --now nginx
